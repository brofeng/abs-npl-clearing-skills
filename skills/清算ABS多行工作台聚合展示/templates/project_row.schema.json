{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ABS workbench row (74-deal contract)",
  "type": "object",
  "required": [
    "bank",
    "proj",
    "variety",
    "issue_date",
    "state",
    "life",
    "issue",
    "pool",
    "sec_rate",
    "sub_pct",
    "coupon",
    "recovery",
    "exp",
    "achieve",
    "dispose",
    "servicer",
    "fee",
    "sen_xirr",
    "recovered",
    "sen_issue",
    "sub_issue",
    "line",
    "year",
    "fails",
    "skips"
  ],
  "properties": {
    "bank": {
      "enum": [
        "中信银行",
        "招商银行",
        "建设银行",
        "兴业银行",
        "农业银行"
      ]
    },
    "proj": {
      "type": "string",
      "minLength": 1
    },
    "variety": {
      "enum": [
        "信用卡不良",
        "个人经营不良",
        "个人消费不良",
        "住房抵押不良"
      ]
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "legal": {
      "type": [
        "string",
        "null"
      ]
    },
    "term": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "settled",
        "open"
      ]
    },
    "life": {
      "type": "integer",
      "minimum": 1
    },
    "issue": {
      "type": "number",
      "minimum": 0
    },
    "pool": {
      "type": "number",
      "minimum": 0
    },
    "sec_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sub_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "coupon": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "recovery": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "exp": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "achieve": {
      "type": "number",
      "minimum": 0,
      "maximum": 3
    },
    "dispose": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "servicer": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "fee": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sen_xirr": {
      "type": "number"
    },
    "sub_xirr": {
      "type": [
        "number",
        "null"
      ]
    },
    "mult": {
      "type": [
        "number",
        "null"
      ]
    },
    "n_loans": {
      "type": [
        "integer",
        "null"
      ]
    },
    "n_bor": {
      "type": [
        "integer",
        "null"
      ]
    },
    "avg_loan": {
      "type": [
        "number",
        "null"
      ]
    },
    "wavg_od": {
      "type": [
        "number",
        "null"
      ]
    },
    "sub_bal": {
      "type": [
        "number",
        "null"
      ]
    },
    "doubt": {
      "type": [
        "number",
        "null"
      ]
    },
    "loss": {
      "type": [
        "number",
        "null"
      ]
    },
    "sub_amt": {
      "type": [
        "number",
        "null"
      ]
    },
    "doubt_amt": {
      "type": [
        "number",
        "null"
      ]
    },
    "loss_amt": {
      "type": [
        "number",
        "null"
      ]
    },
    "recovered": {
      "type": "number",
      "minimum": 0
    },
    "sen_issue": {
      "type": "number",
      "minimum": 0
    },
    "sub_issue": {
      "type": "number",
      "minimum": 0
    },
    "line": {
      "type": "string"
    },
    "year": {
      "type": "string",
      "pattern": "^20[0-9]{2}$"
    },
    "fails": {
      "type": "array"
    },
    "skips": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
